{
  "name": "chicurb-chicago-free-parking-map",
  "private": true,
  "version": "1.0.0",
  "description": "High-performance Chicago Free Parking Map using 672-bit weekly curb bitmasks, PMTiles/GeoJSON, and MapLibre GL JS",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "etl:export": "python backend/chicago_parking_etl.py --export-local public/data",
    "etl:test": "python -m unittest backend/test_etl.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
